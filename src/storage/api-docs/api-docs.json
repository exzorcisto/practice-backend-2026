{
    "openapi": "3.0.0",
    "info": {
        "title": "Survey API",
        "description": "Документация системы опросов (Manual)",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Локальный сервер"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": ["Auth"],
                "summary": "Авторизация",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": { "type": "string", "example": "admin@example.com" },
                                    "password": { "type": "string", "example": "password" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Успешно" }
                }
            }
        },
        "/api/listener/surveys/{surveyId}/answers": {
            "post": {
                "tags": ["Answers"],
                "summary": "Пройти опрос",
                "security": [{ "sanctum": [] }],
                "parameters": [
                    { "name": "surveyId", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "answers": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "question_id": { "type": "integer" },
                                                "option_id": { "type": "integer", "nullable": true },
                                                "text_answer": { "type": "string", "nullable": true }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Сохранено" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}